{
  "name": "smart-mobility-aid-backend",
  "version": "1.0.0",
  "description": "Offline-first ESP32 mobility aid API",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"simulator/**/*.js\" \"*.js\" \"*.json\" \"*.yml\"",
    "seed": "node src/seed.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "sim": "node simulator/device.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^10.1.3",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
